# AI 提供方地址
AI_BASE_URL=https://api.gemai.cc
# API Key（不要提交到 Git）
AI_API_KEY=sk-your-api-key-here
# 默认模型
AI_MODEL=gemini-3-pro-preview
# 系统提示词（可选）
AI_SYSTEM_PROMPT=You are a helpful assistant.

# ---------- RAG 配置 ----------
# Embedding 模型
AI_EMBEDDING_MODEL=qwen3-embedding-8b
# ChromaDB 地址
CHROMA_URL=http://localhost:8000
# ChromaDB Collection 名称
CHROMA_COLLECTION=knowledge-base
# RAG 检索 Top-K
RAG_TOP_K=5
# RAG 系统提示词
RAG_SYSTEM_PROMPT=你是一个基于知识库的问答助手。请根据提供的文档内容回答问题。如果文档中没有相关信息，请如实告知用户，不要编造答案。回答时请注明信息来源。
